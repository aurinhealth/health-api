{
  "openapi": "3.0.3",
  "info": {
    "title": "Health API - Strength Coach",
    "version": "1.0.1",
    "description": "Private strength-training API for ChatGPT."
  },
  "servers": [
    { "url": "https://health-api.chelseafc-czsk.workers.dev" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/strength/context": {
      "get": {
        "operationId": "getStrengthContext",
        "summary": "Get integrated training context",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/strength/history": {
      "get": {
        "operationId": "getStrengthHistory",
        "summary": "Get completed strength history",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/strength/sheet/today": {
      "get": {
        "operationId": "getTodayStrengthSheet",
        "summary": "Read today's strength sheet",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/strength/generate-plan": {
      "post": {
        "operationId": "generateStrengthPlan",
        "summary": "Generate and write a strength workout",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "date": { "type": "string" },
                  "preview": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/strength/sync": {
      "post": {
        "operationId": "syncStrengthSheet",
        "summary": "Sync completed strength sets to D1",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/strength/analyze": {
      "post": {
        "operationId": "analyzeStrengthWorkout",
        "summary": "Analyze completed workout",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/strength/alternatives": {
      "post": {
        "operationId": "findStrengthAlternatives",
        "summary": "Find exercise alternatives",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "exercise": { "type": "string" },
                  "muscle": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/strength/substitute": {
      "post": {
        "operationId": "substituteStrengthExercise",
        "summary": "Replace an exercise in today's workout",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["from"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "muscle": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" }
        }
      }
    }
  }
}
