{
  "name": "health-api",
  "main": "src/entrypoint.js",
  "rules": [
    {
      "type": "Text",
      "globs": ["**/dashboard-client.js"],
      "fallthrough": false
    }
  ],
  "compatibility_date": "2026-09-15",
  // Same as Workers Logs in the Cloudflare dashboard, so a deploy keeps it.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "5 1 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "health-data",
      "database_id": "07caba2e-ba9a-4191-8a2e-e2fd4c5082cd",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": true,
  // The owner is the first admin; existing single-user data belongs to this account.
  "vars": {
    "OWNER_EMAIL": "chelseafc.czsk@gmail.com"
  }
}
