{
  "name": "health-api",
  // main.js is entrypoint.js behind HTTPS and security headers (web-security.js).
  "main": "src/main.js",
  "compatibility_date": "2026-09-15",
  // AsyncLocalStorage (node:async_hooks) holds the user's language during a
  // request, see src/lang.js.
  "compatibility_flags": ["nodejs_als"],
  // Smart Placement runs the Worker near the D1 database instead of near the
  // visitor when that is faster: one page load makes many database reads.
  // Its status is under Workers → health-api → Settings → Placement.
  "placement": {
    "mode": "smart"
  },
  // Local development uses https, as in production, so the HTTPS redirect in
  // web-security.js does not send the page back to itself.
  "dev": {
    "upstream_protocol": "https"
  },
  // Screenshots for the overview page on /. A request matching a file here never reaches the Worker.
  "assets": {
    "directory": "./public"
  },
  // Same as Workers Logs in the Cloudflare dashboard, so a deploy keeps it.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    // One request in ten traced (D1, fetch to Intervals and the AI, R2), so
    // a slow screen shows where its time went in the Cloudflare dashboard.
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "5 1 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "health-data",
      "database_id": "07caba2e-ba9a-4191-8a2e-e2fd4c5082cd",
      "migrations_dir": "migrations"
    }
  ],
  // The read-only world food catalogue (src/world-foods.js), uploaded with
  // scripts/upload-world-foods.mjs; without current.json in it search skips it.
  // Copied from the old loadwise-food-catalog on 2026-10-30 (R2 can't rename a bucket).
  "r2_buckets": [
    {
      "binding": "FOOD_CATALOG_R2",
      "bucket_name": "aurin-food-catalog"
    }
  ],
  // Cloudflare Email Service: sign-in codes and notices about new passkeys. Nothing is sent
  // until aurin.health is onboarded in Email Service → Email Sending and the Worker has the
  // EMAIL_FROM secret (noreply@aurin.health); until then e-mail sign-in stays hidden.
  "send_email": [
    { "name": "EMAIL" }
  ],
  // The cron runs each user's background jobs in an invocation of their own
  // (src/user-jobs-entrypoint.js), so one run's query limit is not shared by all.
  "services": [
    { "binding": "USER_JOBS", "service": "health-api", "entrypoint": "UserJobs" }
  ],
  // Only aurin.health: a workers.dev address would answer without the zone's
  // Cloudflare rules (rate limiting, WAF), and preview versions share the live database.
  "workers_dev": false,
  "preview_urls": false,
  // The owner is the first admin; existing single-user data belongs to this account.
  "vars": {
    // Provisioned by scripts/provision-user-shards.mjs in the deploy jobs.
    // 20 groups of at most 10 accounts; capacity is also checked in bytes.
    "USER_DATA_ROUTING": "true",
    "FOOD_CATALOG_ROUTING": "true",
    "USER_DATA_SHARD_COUNT": "20",
    // OWNER_EMAIL (the owner's sign-in address, src/tenancy.js) is not here: the deploy
    // passes it from the GitHub environment's secret OWNER_EMAIL (deploy-worker.yml),
    // and wrangler dev reads it from .dev.vars. Problem reports go to CONTACT_EMAIL,
    // the public address on the website (src/support-report.js).
    "CONTACT_EMAIL": "support@aurin.health",
    // Anyone may create an account while shard capacity lasts (src/tenancy.js accountCapacity);
    // when it is full, new e-mails land in signup_waitlist.
    "OPEN_SIGNUP": "true",
    // Emergency brake on an account's AI spending per month (src/ai-usage.js);
    // audit/aurin-pro-ai-limity-plan-2026-10-18.md.
    "AI_MONTHLY_LIMIT_USD": "5",
    // Half of every AI limit (the brake, the daily guard, the coach's week) until
    // the account pays for Pro: the pilot, TestFlight and the free week (src/ai-limit-share.js).
    "AI_UNPAID_LIMIT_SHARE": "0.5",
    // A daily guard against abuse on the AI around the coach (food, plans, reviews); the coach chat is not in it.
    "AI_DAILY_LIMIT_USD": "1",
    // All users together in a UTC day (src/ai-total.js): an e-mail to the owner past
    // the alert; past the limit AI waits until the next day for everyone but the owner.
    "AI_TOTAL_DAILY_ALERT_USD": "10",
    // Each group of accounts has its own daily brake, so one never stops another's AI
    // (src/ai-total.js): per account in the group (paying ones 0.5 USD, the free week
    // half, TestFlight 75 % up to 20, accounts without a purchase older than a week half,
    // up to 30) or fixed where accounts cost nothing to make (new accounts, the server).
    // The owner hears once a day when a group passes half of its brake.
    "AI_GROUP_BRAKES": {
      "paid": { "perAccount": 0.5, "min": 10 },
      "gift": { "perAccount": 0.5, "min": 10 },
      "trial": { "perAccount": 0.25, "min": 5 },
      "testflight": { "perAccount": 0.375, "min": 5, "max": 20 },
      "free": { "perAccount": 0.25, "min": 5, "max": 30 },
      "new": { "usd": 5 },
      "system": { "usd": 5 }
    },
    // The weekly allowance of messages to the coach (src/coach-allowance.js): per week,
    // extra ones to finish a conversation, and how many messages of a conversation
    // after a workout count as one. Unpaid accounts get half (AI_UNPAID_LIMIT_SHARE).
    "COACH_WEEKLY_MESSAGES": "30",
    "COACH_EXTRA_MESSAGES": "2",
    "COACH_WORKOUT_CHAT_MESSAGES": "5",
    // Ultrahuman app (src/ultrahuman.js); public. ULTRAHUMAN_CLIENT_SECRET is a Worker secret.
    "ULTRAHUMAN_CLIENT_ID": "Aiv97cWQZNA3tShnPydr8NtxZXSVv4LCafZE89WBnP4",
    "WHOOP_CLIENT_ID": "0c14cf2e-d6d3-4c7c-8c0d-758b0b20a8aa",
    "WAHOO_CLIENT_ID": "W-nkdGNWUzPdr3a1rN2Z5Wvm7IOXPv_bjdGGmfbToFs",
    // Last day (UTC) the fixed App Review sign-in code works; move it before each review.
    "APP_REVIEW_UNTIL": "2027-01-31"
  },
  "env": {
    // The test server: the same code with its own Worker (health-api-staging)
    // and its own empty databases, so nothing tried there touches live data.
    // A merge to main deploys it; the "Vydat" workflow then deploys the same
    // commit to the live server (.github/workflows/deploy-worker.yml, vydat.yml).
    // Internal testers switch to it in the app (Nastavení → Testování → Server).
    "staging": {
      "name": "health-api-staging",
      // The test server lives in a Cloudflare account of its own, so its token
      // cannot reach the live data. aurin.health stays in the live account:
      // staging.aurin.health is a Cloudflare for SaaS custom hostname of that
      // account's zone aurin-staging.com, and the live zone only has a DNS-only
      // CNAME to it (docs/test-server-and-releases.md). A custom hostname reaches a
      // Worker only through the zone's catch-all route; a route naming the hostname
      // never matches and the request falls through to the empty origin (HTTP 522).
      "routes": [
        { "pattern": "*/*", "zone_name": "aurin-staging.com" }
      ],
      "workers_dev": false,
      "placement": {
        "mode": "smart"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "health-data-staging",
          "database_id": "5d0d935f-a587-4bf5-8264-e290c11eb001",
          "migrations_dir": "migrations"
        }
      ],
      // A copy of the read-only world food catalogue in the test account's own bucket.
      "r2_buckets": [
        {
          "binding": "FOOD_CATALOG_R2",
          "bucket_name": "aurin-food-catalog"
        }
      ],
      // No send_email: Email Sending needs the Workers Paid plan, and the test account
      // is on Free. E-mail sign-in stays hidden there (src/email-sender.js); Apple and
      // Google sign-in work.
      "services": [
        { "binding": "USER_JOBS", "service": "health-api-staging", "entrypoint": "UserJobs" }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://staging.aurin.health",
        "USER_DATA_ROUTING": "true",
        "FOOD_CATALOG_ROUTING": "true",
        "USER_DATA_SHARD_COUNT": "2",
        "CONTACT_EMAIL": "support@aurin.health",
        "OPEN_SIGNUP": "true",
        "AI_MONTHLY_LIMIT_USD": "5",
        "AI_UNPAID_LIMIT_SHARE": "0.5",
        "AI_DAILY_LIMIT_USD": "1",
        // Testing costs at most 5 USD of AI a day, the owner included (src/ai-total.js):
        // room for a few full coach evaluations (about 0.65 USD each) and app testing.
        "AI_TOTAL_DAILY_ALERT_USD": "3",
        "AI_TOTAL_DAILY_LIMIT_USD": "5",
        "AI_GROUP_BRAKES": { "paid": { "usd": 0.5 }, "gift": { "usd": 1 }, "trial": { "usd": 0.5 }, "testflight": { "usd": 0.5 }, "free": { "usd": 0.5 }, "new": { "usd": 0.5 }, "system": { "usd": 0.5 } },
        "COACH_WEEKLY_MESSAGES": "30",
        "COACH_EXTRA_MESSAGES": "2",
        "COACH_WORKOUT_CHAT_MESSAGES": "5",
        "ULTRAHUMAN_CLIENT_ID": "Aiv97cWQZNA3tShnPydr8NtxZXSVv4LCafZE89WBnP4",
        "WHOOP_CLIENT_ID": "0c14cf2e-d6d3-4c7c-8c0d-758b0b20a8aa",
        "WAHOO_CLIENT_ID": "W-nkdGNWUzPdr3a1rN2Z5Wvm7IOXPv_bjdGGmfbToFs",
        "APP_REVIEW_UNTIL": "2027-01-31"
      }
    }
  }
}
