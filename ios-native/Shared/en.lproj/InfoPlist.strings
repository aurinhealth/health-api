"NSCameraUsageDescription" = "Aurin photographs meals and nutrition labels to log them in your food diary, reads the barcodes on food packaging, takes the background photo for an image you share and the photos you send to the coach.";
"NSPhotoLibraryUsageDescription" = "Aurin loads the photo you pick: a meal or a nutrition label for your food diary, the gym, a photo for the coach or a background to share.";
"NSLocationWhenInUseUsageDescription" = "Aurin uses your location only when you ask, to show the weather and let the coach advise training outdoors or indoors.";
"NSHealthShareUsageDescription" = "Aurin reads sleep, workouts and their routes, heart rate, HRV, breathing, blood oxygen, wrist temperature, steps, weight, height, age and sex, food and water from other apps, and your mood from Apple Health. For the journal it reads mindful minutes, time in daylight, noise in sleep and symptoms, sexual activity only when you add it to your journal, and with cycle tracking on, periods, ovulation tests and contraception. It uses them to work out your recovery, strain and calorie target and to fill in your journal.";
"NSHealthUpdateUsageDescription" = "Aurin writes to Apple Health only what you log in the app yourself and turn on in Sync, such as workouts, weight, food and drinks, and the mood from your journal.";
"NSAlarmKitUsageDescription" = "Aurin wakes you at your alarm time, which it uses to work out your bedtime.";
"NSFaceIDUsageDescription" = "Aurin asks for Face ID before it deletes your account.";
"NSBluetoothAlwaysUsageDescription" = "Aurin connects to the heart rate sensor you pair, to show your heart rate in workout mode.";
"NSCalendarsFullAccessUsageDescription" = "Aurin uses the events in your calendar to see how much time you have for training each day and, if you turn it on, adds your planned workouts to it. Your events stay on your phone.";
"NSCalendarsUsageDescription" = "Aurin uses the events in your calendar to see how much time you have for training each day and, if you turn it on, adds your planned workouts to it. Your events stay on your phone.";
